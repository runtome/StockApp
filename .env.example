# ── Backend (Hugging Face Space) ───────────────────────────────────────────────
# URL of the FastAPI backend deployed on Hugging Face Spaces.
# Leave empty to run entirely on mock data (no backend required).
HF_SPACE_URL=

# Optional Bearer token — only needed for private HF Spaces.
# Leave empty for public spaces.
HF_SPACE_TOKEN=

# ── App metadata ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Thai Stock AI
NEXT_PUBLIC_DEFAULT_THEME=dark
